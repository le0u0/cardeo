# Optional locally: without these, persistent embedded PostgreSQL uses .cardeo/.
# Required on Cloudflare (wrangler secret put ...). Server-side only; never use NEXT_PUBLIC_ prefixes here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: openssl rand -hex 32. Required on hosted deployments.
CHECKOUT_RATE_SECRET=
# Set HOSTED=true on deployed environments (set in wrangler.jsonc).
HOSTED=
# Set false to use original geometric motifs instead of the sample's reference art.
REFERENCE_ART=true
